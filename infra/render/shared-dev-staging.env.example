SHARED_DEV_BASIC_AUTH_USERNAME=replace-me
SHARED_DEV_BASIC_AUTH_PASSWORD=replace-me
STAGING_BASIC_AUTH_USERNAME=replace-me
STAGING_BASIC_AUTH_PASSWORD=replace-me
RENDER_API_KEY=replace-me
NODE_ENV=production

# Single server-side OpenAI-compatible model entry. Keep MODEL_API_KEY in the
# host secret manager; never expose it as a NEXT_PUBLIC variable.
MODEL_BASE_URL=https://api.vibekey.cn/v1
MODEL_API_KEY=
MODEL_NAME=grok-4.5
MODEL_PROVIDER_ID=vibekey
MODEL_TIMEOUT_MS=180000

# Zero-spoiler candidate mechanism library. Default is deliberately off.
# Use shadow only for internal trace collection; active is an explicit A/B arm.
VNEXT_SPOILER_SAFE_MECHANISM_MODE=off
VNEXT_SPOILER_SAFE_MECHANISM_RETRIEVAL_LIMIT=3

# vNext guest sessions stay fail-closed until all values are approved and versioned.
VNEXT_ALLOWED_ORIGINS=
VNEXT_SESSION_COOKIE_SECURE=true
VNEXT_SESSION_TOKEN_SECRET=
VNEXT_INTERNAL_ADMISSION_POLICY_VERSION=
VNEXT_INTERNAL_AI_NOTICE_VERSION=
VNEXT_INTERNAL_TERMS_VERSION=
VNEXT_INTERNAL_PRIVACY_VERSION=
VNEXT_GUEST_SESSION_TTL_SECONDS=86400
VNEXT_SESSION_RATE_LIMIT_MAX=20
VNEXT_SESSION_RATE_LIMIT_WINDOW_MS=60000
