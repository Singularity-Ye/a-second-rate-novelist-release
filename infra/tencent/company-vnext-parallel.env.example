# Copy to the company server as an untracked, mode-600 .env.vnext file.
# This example contains no usable passwords, tokens, or provider credentials.
COMPOSE_PROJECT_NAME=erlx-vnext

# Company builds use Tencent's public Debian mirror to avoid cross-border apt
# stalls. Other deployments keep the Dockerfile's official Debian default.
DEBIAN_MIRROR_URL=http://mirrors.cloud.tencent.com

# Caddy is disabled by default in the parallel overlay. These remain valid
# interpolation inputs for the base compose and are not public cutover approval.
SHARED_DEV_DOMAIN=shared-dev.lumialove.xn--6qq986b3xl
STAGING_DOMAIN=staging.lumialove.xn--6qq986b3xl
SHARED_DEV_BASIC_AUTH_USERNAME=vnext-shared
SHARED_DEV_BASIC_AUTH_PASSWORD=
STAGING_BASIC_AUTH_USERNAME=vnext-staging
STAGING_BASIC_AUTH_PASSWORD=

POSTGRES_ROOT_PASSWORD=
SHARED_DEV_DB_NAME=erlx_vnext_shared_dev
SHARED_DEV_DB_USER=erlx_vnext_shared_dev
SHARED_DEV_DB_PASSWORD=
STAGING_DB_NAME=erlx_vnext_staging
STAGING_DB_USER=erlx_vnext_staging
STAGING_DB_PASSWORD=

MINIO_ROOT_USER=erlx-vnext-minio
MINIO_ROOT_PASSWORD=
SHARED_DEV_BUCKET=erlx-vnext-shared-dev
STAGING_BUCKET=erlx-vnext-staging
AWS_REGION=ap-shanghai

# Loopback-only preview. Reach it through SSH over the Tailscale path.
VNEXT_PREVIEW_BIND_ADDRESS=127.0.0.1
SHARED_DEV_PREVIEW_PORT=3330
STAGING_PREVIEW_PORT=3331
SHARED_DEV_PREVIEW_ORIGIN=http://127.0.0.1:3330
STAGING_PREVIEW_ORIGIN=http://127.0.0.1:3331
H5_BASE_URL=http://127.0.0.1:3330

SHARED_DEV_VNEXT_ALLOWED_ORIGINS=http://127.0.0.1:3330
SHARED_DEV_VNEXT_SESSION_TOKEN_SECRET=
SHARED_DEV_VNEXT_INTERNAL_ADMISSION_POLICY_VERSION=
SHARED_DEV_VNEXT_INTERNAL_AI_NOTICE_VERSION=
SHARED_DEV_VNEXT_INTERNAL_TERMS_VERSION=
SHARED_DEV_VNEXT_INTERNAL_PRIVACY_VERSION=
STAGING_VNEXT_ALLOWED_ORIGINS=http://127.0.0.1:3331
STAGING_VNEXT_SESSION_TOKEN_SECRET=
STAGING_VNEXT_INTERNAL_ADMISSION_POLICY_VERSION=
STAGING_VNEXT_INTERNAL_AI_NOTICE_VERSION=
STAGING_VNEXT_INTERNAL_TERMS_VERSION=
STAGING_VNEXT_INTERNAL_PRIVACY_VERSION=
VNEXT_GUEST_SESSION_TTL_SECONDS=86400
VNEXT_SESSION_RATE_LIMIT_MAX=20
VNEXT_SESSION_RATE_LIMIT_WINDOW_MS=60000

# Cluster-wide model-stream admission for the company overlay. The backend
# selects Redis explicitly; shared-dev/staging use isolated Redis DBs and
# namespaces. Redis failure is fail-closed and never falls back to memory.
VNEXT_MODEL_STREAMS_PER_PRINCIPAL=1
VNEXT_MODEL_STREAMS_PER_PROFILE=2
VNEXT_MODEL_STREAMS_GLOBAL=4
VNEXT_MODEL_STREAM_RETRY_AFTER_SECONDS=2
VNEXT_MODEL_ADMISSION_LEASE_TTL_MS=300000
VNEXT_MODEL_ADMISSION_OPERATION_TIMEOUT_MS=2000

# Server-approved model profiles. ENABLED may be true, false, or empty:
# - empty ENABLED + empty PROVIDER/MODEL = not_configured
# - true requires PROVIDER/MODEL here and BASE_URL/API_KEY below
# - false explicitly disables the profile
# PURPOSES accepts conversation, analysis, or conversation,analysis.
# Defaults must stay empty until the referenced profile is available for that
# purpose. Backend receives only this metadata; profile credentials are mapped
# exclusively into model-gateway.
VNEXT_MODEL_PROFILE_DEEPSEEK_ENABLED=
VNEXT_MODEL_PROFILE_DEEPSEEK_PROVIDER=
VNEXT_MODEL_PROFILE_DEEPSEEK_MODEL=
VNEXT_MODEL_PROFILE_DEEPSEEK_PURPOSES=conversation
VNEXT_MODEL_PROFILE_GPT_ENABLED=
VNEXT_MODEL_PROFILE_GPT_PROVIDER=
VNEXT_MODEL_PROFILE_GPT_MODEL=
VNEXT_MODEL_PROFILE_GPT_PURPOSES=conversation
VNEXT_MODEL_PROFILE_GEMINI_ENABLED=
VNEXT_MODEL_PROFILE_GEMINI_PROVIDER=
VNEXT_MODEL_PROFILE_GEMINI_MODEL=
VNEXT_MODEL_PROFILE_GEMINI_PURPOSES=conversation
VNEXT_MODEL_PROFILE_GROK_ENABLED=
VNEXT_MODEL_PROFILE_GROK_PROVIDER=
VNEXT_MODEL_PROFILE_GROK_MODEL=
VNEXT_MODEL_PROFILE_GROK_PURPOSES=analysis
VNEXT_DEFAULT_CONVERSATION_PROFILE_ID=
VNEXT_DEFAULT_ANALYSIS_PROFILE_ID=

# Gateway-only profile endpoints and credentials. Leave both values empty when
# the matching profile is not_configured; never place real keys in this example.
VNEXT_MODEL_PROFILE_DEEPSEEK_BASE_URL=
VNEXT_MODEL_PROFILE_DEEPSEEK_API_KEY=
VNEXT_MODEL_PROFILE_GPT_BASE_URL=
VNEXT_MODEL_PROFILE_GPT_API_KEY=
VNEXT_MODEL_PROFILE_GEMINI_BASE_URL=
VNEXT_MODEL_PROFILE_GEMINI_API_KEY=
VNEXT_MODEL_PROFILE_GROK_BASE_URL=
VNEXT_MODEL_PROFILE_GROK_API_KEY=

# Legacy gateway bootstrap routes. Keep these until the gateway no longer
# requires creative-large/light as its primary compatibility route.
# MODEL_GATEWAY_TOKEN is a separate random bearer token shared only by backend
# and model-gateway; it is not a provider credential.
MODEL_BASE_URL=https://api.vibekey.cn/v1
MODEL_API_KEY=
MODEL_NAME=grok-4.5
MODEL_PROVIDER_ID=vibekey
MODEL_LIGHT_BASE_URL=
MODEL_LIGHT_API_KEY=
MODEL_LIGHT_NAME=deepseek-v4-flash
MODEL_LIGHT_PROVIDER_ID=deepseek
MODEL_GATEWAY_TOKEN=
MODEL_TIMEOUT_MS=180000

VNEXT_SPOILER_SAFE_MECHANISM_MODE=off
VNEXT_SPOILER_SAFE_MECHANISM_RETRIEVAL_LIMIT=3
CAPABILITY_ROUTE_ASR_PROVIDER=
CAPABILITY_ROUTE_ASR_MODEL=
CAPABILITY_ROUTE_OCR_DOCUMENT_EXTRACTION_PROVIDER=
CAPABILITY_ROUTE_OCR_DOCUMENT_EXTRACTION_MODEL=
CAPABILITY_ROUTE_VISION_UNDERSTANDING_PROVIDER=
CAPABILITY_ROUTE_VISION_UNDERSTANDING_MODEL=
CAPABILITY_ROUTE_POLICY_MODERATION_PROVIDER=
CAPABILITY_ROUTE_POLICY_MODERATION_MODEL=
HUMAN_REVIEW_QUEUE=ops-human-review
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
PROMPTFOO_ENABLED=false
OPIK_API_KEY=
OPIK_WORKSPACE=erliu-xiaoshuojia
OPIK_PROJECT_NAME=story-runtime
