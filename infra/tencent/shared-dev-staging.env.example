COMPOSE_PROJECT_NAME=erlx-hosted
SHARED_DEV_DOMAIN=shared-dev.lumialove.xn--6qq986b3xl
STAGING_DOMAIN=staging.lumialove.xn--6qq986b3xl
SHARED_DEV_BASIC_AUTH_USERNAME=shared
SHARED_DEV_BASIC_AUTH_PASSWORD=replace-me
STAGING_BASIC_AUTH_USERNAME=staging
STAGING_BASIC_AUTH_PASSWORD=replace-me
POSTGRES_ROOT_PASSWORD=replace-me
SHARED_DEV_DB_NAME=erlx_shared_dev
SHARED_DEV_DB_USER=erlx_shared_dev
SHARED_DEV_DB_PASSWORD=replace-me
STAGING_DB_NAME=erlx_staging
STAGING_DB_USER=erlx_staging
STAGING_DB_PASSWORD=replace-me
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=replace-me
SHARED_DEV_BUCKET=erlx-shared-dev
STAGING_BUCKET=erlx-staging
AWS_REGION=ap-shanghai
H5_BASE_URL=https://shared-dev.lumialove.xn--6qq986b3xl

# vNext guest sessions stay fail-closed until each environment has approved values.
# Generate each token secret with: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
SHARED_DEV_VNEXT_ALLOWED_ORIGINS=https://shared-dev.lumialove.xn--6qq986b3xl
SHARED_DEV_VNEXT_SESSION_TOKEN_SECRET=
SHARED_DEV_VNEXT_INTERNAL_ADMISSION_POLICY_VERSION=
SHARED_DEV_VNEXT_INTERNAL_AI_NOTICE_VERSION=
SHARED_DEV_VNEXT_INTERNAL_TERMS_VERSION=
SHARED_DEV_VNEXT_INTERNAL_PRIVACY_VERSION=
STAGING_VNEXT_ALLOWED_ORIGINS=https://staging.lumialove.xn--6qq986b3xl
STAGING_VNEXT_SESSION_TOKEN_SECRET=
STAGING_VNEXT_INTERNAL_ADMISSION_POLICY_VERSION=
STAGING_VNEXT_INTERNAL_AI_NOTICE_VERSION=
STAGING_VNEXT_INTERNAL_TERMS_VERSION=
STAGING_VNEXT_INTERNAL_PRIVACY_VERSION=
VNEXT_GUEST_SESSION_TTL_SECONDS=86400
VNEXT_SESSION_RATE_LIMIT_MAX=20
VNEXT_SESSION_RATE_LIMIT_WINDOW_MS=60000

# Server-side model routes. Provider keys are consumed only by the private
# model-gateway container; backend containers receive MODEL_GATEWAY_TOKEN only.
# All three secret slots must live in the server's untracked .env.hosted file.
# Validate dual routing without printing secrets:
# pnpm hosted:ai-preflight -- --env-file .env.hosted --require-isolated-light
MODEL_BASE_URL=https://api.vibekey.cn/v1
MODEL_API_KEY=
MODEL_NAME=grok-4.5
MODEL_PROVIDER_ID=vibekey
MODEL_LIGHT_BASE_URL=
MODEL_LIGHT_API_KEY=
MODEL_LIGHT_NAME=deepseek-v4-flash
MODEL_LIGHT_PROVIDER_ID=deepseek
MODEL_GATEWAY_TOKEN=
MODEL_TIMEOUT_MS=180000
VNEXT_SPOILER_SAFE_MECHANISM_MODE=off
VNEXT_SPOILER_SAFE_MECHANISM_RETRIEVAL_LIMIT=3
CAPABILITY_ROUTE_ASR_PROVIDER=
CAPABILITY_ROUTE_ASR_MODEL=
CAPABILITY_ROUTE_OCR_DOCUMENT_EXTRACTION_PROVIDER=
CAPABILITY_ROUTE_OCR_DOCUMENT_EXTRACTION_MODEL=
CAPABILITY_ROUTE_VISION_UNDERSTANDING_PROVIDER=
CAPABILITY_ROUTE_VISION_UNDERSTANDING_MODEL=
CAPABILITY_ROUTE_POLICY_MODERATION_PROVIDER=
CAPABILITY_ROUTE_POLICY_MODERATION_MODEL=
HUMAN_REVIEW_QUEUE=ops-human-review
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
PROMPTFOO_ENABLED=false
OPIK_API_KEY=
OPIK_WORKSPACE=erliu-xiaoshuojia
OPIK_PROJECT_NAME=story-runtime
