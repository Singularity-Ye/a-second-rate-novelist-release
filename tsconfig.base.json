{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@erliu/shared-contracts": ["packages/shared-contracts/index.ts"],
      "@erliu/shared-contracts/*": ["packages/shared-contracts/*"],
      "@erliu/telemetry": ["packages/telemetry/index.ts"],
      "@erliu/telemetry/*": ["packages/telemetry/*"]
    }
  }
}
