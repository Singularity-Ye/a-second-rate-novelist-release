generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VnextPrincipalKind {
  GUEST   @map("guest")
  ACCOUNT @map("account")

  @@map("vnext_principal_kind")
}

enum VnextExperienceAuthState {
  GUEST_ACTIVE   @map("guest_active")
  BINDING        @map("binding")
  ACCOUNT_ACTIVE @map("account_active")
  EXPIRED        @map("expired")

  @@map("vnext_experience_auth_state")
}

enum VnextAudienceMode {
  INTERNAL                @map("internal")
  VERIFIED_ADULT_EXTERNAL @map("verified_adult_external")

  @@map("vnext_audience_mode")
}

enum VnextInputPolicy {
  SYNTHETIC_ONLY @map("synthetic_only")
  REAL_INPUT     @map("real_input")

  @@map("vnext_input_policy")
}

enum VnextComplianceStatus {
  PENDING   @map("pending")
  ELIGIBLE  @map("eligible")
  WITHDRAWN @map("withdrawn")
  BLOCKED   @map("blocked")
  EXPIRED   @map("expired")

  @@map("vnext_compliance_status")
}

enum VnextAgeVerificationStatus {
  PENDING        @map("pending")
  VERIFIED_ADULT @map("verified_adult")
  REJECTED       @map("rejected")
  EXPIRED        @map("expired")

  @@map("vnext_age_verification_status")
}

enum VnextSourceMessageAction {
  COMMISSION      @map("commission")
  CORRECTION      @map("correction")
  BOUNDARY_UPDATE @map("boundary_update")

  @@map("vnext_source_message_action")
}

enum VnextUnderstandingStatus {
  PROPOSED  @map("proposed")
  CORRECTED @map("corrected")
  CONFIRMED @map("confirmed")
  EXPIRED   @map("expired")

  @@map("vnext_understanding_status")
}

enum VnextStoryWorkspaceStatus {
  FORMING  @map("forming")
  ACTIVE   @map("active")
  PAUSED   @map("paused")
  ARCHIVED @map("archived")

  @@map("vnext_story_workspace_status")
}

enum VnextCommissionStatus {
  DRAFT      @map("draft")
  ACTIVE     @map("active")
  SUPERSEDED @map("superseded")

  @@map("vnext_commission_status")
}

enum VnextReaderMemoryScope {
  PRINCIPAL @map("principal")

  @@map("vnext_reader_memory_scope")
}

enum VnextReaderMemoryItemKind {
  TASTE         @map("taste")
  HARD_BOUNDARY @map("hard_boundary")

  @@map("vnext_reader_memory_item_kind")
}

enum VnextReaderMemoryItemStatus {
  PROVISIONAL @map("provisional")
  CONFIRMED   @map("confirmed")
  ACTIVE      @map("active")
  REVOKED     @map("revoked")

  @@map("vnext_reader_memory_item_status")
}

enum VnextCreativeTaskKind {
  UNDERSTAND     @map("understand")
  WRITE_OPENING  @map("write_opening")
  REVISE         @map("revise")
  CONTINUE_STORY @map("continue_story")

  @@map("vnext_creative_task_kind")
}

enum VnextCreativeTaskStatus {
  QUEUED     @map("queued")
  LEASED     @map("leased")
  RETRY_WAIT @map("retry_wait")
  SUCCEEDED  @map("succeeded")
  FAILED     @map("failed")
  CANCELLED  @map("cancelled")
  TIMED_OUT  @map("timed_out")
  BLOCKED    @map("blocked")

  @@map("vnext_creative_task_status")
}

enum VnextCreativeRunStatus {
  RUNNING       @map("running")
  SUCCEEDED     @map("succeeded")
  FAILED        @map("failed")
  TIMED_OUT     @map("timed_out")
  BLOCKED       @map("blocked")
  CANCELLED     @map("cancelled")
  LEASE_EXPIRED @map("lease_expired")
  STALE_INPUT   @map("stale_input")

  @@map("vnext_creative_run_status")
}

enum VnextCreativeRuntimeMode {
  SYNTHETIC  @map("runtime_worker_synthetic")
  CONFIGURED @map("runtime_worker_configured")

  @@map("vnext_creative_runtime_mode")
}

enum VnextStoryContentKind {
  OPENING @map("opening")
  SCENE   @map("scene")
  CHAPTER @map("chapter")

  @@map("vnext_story_content_kind")
}

enum VnextStoryContentStatus {
  DRAFT    @map("draft")
  REVISION @map("revision")
  ACCEPTED @map("accepted")
  REJECTED @map("rejected")

  @@map("vnext_story_content_status")
}

enum VnextOutboxEventStatus {
  PENDING     @map("pending")
  LEASED      @map("leased")
  RETRY_WAIT  @map("retry_wait")
  PUBLISHED   @map("published")
  DEAD_LETTER @map("dead_letter")

  @@map("vnext_outbox_event_status")
}

enum VnextWorkerKind {
  CREATIVE @map("creative")
  OUTBOX   @map("outbox")

  @@map("vnext_worker_kind")
}

enum VnextWorkerStatus {
  STARTING @map("starting")
  READY    @map("ready")
  DRAINING @map("draining")
  STOPPED  @map("stopped")
  ERROR    @map("error")

  @@map("vnext_worker_status")
}

enum VnextProcessingPurpose {
  UNVERIFIED_MIGRATED @map("unverified_migrated")
  SYNTHETIC_CREATIVE  @map("synthetic_creative")
  CORE_CREATIVE       @map("core_creative")
  EXTERNAL_EXPERIENCE @map("external_experience")
  MODEL_TRAINING      @map("model_training")

  @@map("vnext_processing_purpose")
}

enum VnextProcessingBasisStatus {
  ACTIVE  @map("active")
  REVOKED @map("revoked")
  EXPIRED @map("expired")

  @@map("vnext_processing_basis_status")
}

enum VnextConsentKind {
  REQUIRED @map("required")
  OPTIONAL @map("optional")

  @@map("vnext_consent_kind")
}

enum VnextConsentStatus {
  ACTIVE    @map("active")
  WITHDRAWN @map("withdrawn")

  @@map("vnext_consent_status")
}

enum VnextSafetyTriggerType {
  INPUT_POLICY    @map("input_policy")
  OUTPUT_POLICY   @map("output_policy")
  CRISIS          @map("crisis")
  ILLEGAL_CONTENT @map("illegal_content")

  @@map("vnext_safety_trigger_type")
}

enum VnextSafetySeverity {
  LOW      @map("low")
  MEDIUM   @map("medium")
  HIGH     @map("high")
  CRITICAL @map("critical")

  @@map("vnext_safety_severity")
}

enum VnextSafetyDisposition {
  SUPPORT  @map("support")
  BLOCK    @map("block")
  ESCALATE @map("escalate")
  RESTRICT @map("restrict")

  @@map("vnext_safety_disposition")
}

enum VnextSafetyCaseStatus {
  OPEN     @map("open")
  APPEALED @map("appealed")
  RESOLVED @map("resolved")

  @@map("vnext_safety_case_status")
}

enum VnextContinuousUseReceiptStatus {
  PENDING      @map("pending")
  ACKNOWLEDGED @map("acknowledged")

  @@map("vnext_continuous_use_receipt_status")
}

enum VnextModelPurpose {
  CONVERSATION @map("conversation")
  ANALYSIS     @map("analysis")

  @@map("vnext_model_purpose")
}

enum VnextSystemSupportCommandType {
  REGISTER_SOURCE             @map("register_source")
  ISSUE_SUBSYSTEM_DIRECTIVE   @map("issue_subsystem_directive")
  PUBLISH_HOST_TASK           @map("publish_host_task")
  RECORD_HOST_CHOICE          @map("record_host_choice")
  COMPILE_ENCOUNTER           @map("compile_encounter")
  RECORD_MANIFESTATION        @map("record_manifestation")
  RECORD_CREATIVE_ATTEMPT     @map("record_creative_attempt")
  RECORD_FORMAL_EVIDENCE      @map("record_formal_evidence")
  CLOSE_DAY                   @map("close_day")

  @@map("vnext_system_support_command_type")
}

enum VnextSystemSupportCommandActor {
  MAIN_SYSTEM     @map("main_system")
  SUBSYSTEM       @map("subsystem")
  NOVELIST        @map("novelist")
  LIFE_RUNTIME    @map("life_runtime")
  CREATIVE_RUNTIME @map("creative_runtime")
  SYSTEM_RUNTIME  @map("system_runtime")

  @@map("vnext_system_support_command_actor")
}

enum VnextSystemSupportFactType {
  SOURCE_MATERIAL         @map("source_material")
  SUBSYSTEM_DIRECTIVE     @map("subsystem_directive")
  HOST_TASK_DRAFT         @map("host_task_draft")
  PUBLISHED_HOST_TASK     @map("published_host_task")
  HOST_TASK_CHOICE        @map("host_task_choice")
  ENCOUNTER_PLAN          @map("encounter_plan")
  ENCOUNTER_MANIFESTATION @map("encounter_manifestation")
  CREATIVE_ATTEMPT        @map("creative_attempt")
  FORMAL_WORK_EVIDENCE    @map("formal_work_evidence")
  DAY_CLOSE               @map("day_close")

  @@map("vnext_system_support_fact_type")
}

model VnextPrincipal {
  id                  String                       @id @default(uuid()) @db.Uuid
  kind                VnextPrincipalKind           @default(GUEST)
  createdAt           DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(6)
  experienceSessions  VnextExperienceSession[]
  sourceMessages      VnextSourceMessage[]         @relation("VnextSourceMessageOwner")
  storyWorkspaces     VnextStoryWorkspace[]        @relation("VnextStoryWorkspaceOwner")
  understandingDrafts VnextUnderstandingDraft[]    @relation("VnextUnderstandingOwner")
  commissionBriefs    VnextCommissionBrief[]       @relation("VnextCommissionOwner")
  readerMemory        VnextReaderMemory?           @relation("VnextReaderMemoryOwner")
  readerMemoryItems   VnextReaderMemoryItem[]      @relation("VnextReaderMemoryItemOwner")
  creativeTasks       VnextCreativeTask[]          @relation("VnextCreativeTaskOwner")
  creativeRunTraces   VnextCreativeRunTrace[]      @relation("VnextCreativeRunOwner")
  storyContents       VnextStoryContent[]          @relation("VnextStoryContentOwner")
  outboxEvents        VnextOutboxEvent[]           @relation("VnextOutboxEventOwner")
  processingBases     VnextProcessingBasisRecord[] @relation("VnextProcessingBasisOwner")
  consents            VnextConsentRecord[]         @relation("VnextConsentOwner")
  safetyCases         VnextSafetyCase[]            @relation("VnextSafetyCaseOwner")
  safetyAppeals       VnextSafetyAppealRecord[]    @relation("VnextSafetyAppealOwner")
  continuousUseReceipts VnextContinuousUseReminderReceipt[] @relation("VnextContinuousUseReceiptOwner")
  systemSupportCases  VnextSystemSupportCase[]     @relation("VnextSystemSupportCaseOwner")
  modelPreferences    VnextModelPreference[]       @relation("VnextModelPreferenceOwner")

  @@map("vnext_principals")
}

model VnextModelPreference {
  id               String            @id @default(uuid()) @db.Uuid
  ownerPrincipalId String            @map("owner_principal_id") @db.Uuid
  purpose          VnextModelPurpose
  profileId        String            @map("profile_id") @db.VarChar(32)
  revision         Int               @default(1)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  owner            VnextPrincipal    @relation("VnextModelPreferenceOwner", fields: [ownerPrincipalId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([ownerPrincipalId, purpose], map: "vnext_model_preferences_owner_purpose_key")
  @@index([profileId, purpose], map: "vnext_model_preferences_profile_purpose_idx")
  @@map("vnext_model_preferences")
}

model VnextExperienceSession {
  id                          String                     @id @default(uuid()) @db.Uuid
  principalId                 String                     @map("principal_id") @db.Uuid
  cookieTokenHash             String                     @unique @map("cookie_token_hash") @db.Char(64)
  clientRequestId             String                     @unique @map("client_request_id") @db.Uuid
  bootstrapRecoverySecretHash String                     @unique @map("bootstrap_recovery_secret_hash") @db.Char(64)
  projectionVersionId         String                     @unique @default(uuid()) @map("projection_version_id") @db.Uuid
  surface                     String                     @default("vnext")
  authState                   VnextExperienceAuthState   @default(GUEST_ACTIVE) @map("auth_state")
  ageMode                     VnextAgeVerificationStatus @default(PENDING) @map("age_mode")
  aiIdentityAcknowledgedAt    DateTime                   @map("ai_identity_acknowledged_at") @db.Timestamptz(6)
  guestExpiresAt              DateTime                   @map("guest_expires_at") @db.Timestamptz(6)
  expiresAt                   DateTime                   @map("expires_at") @db.Timestamptz(6)
  revokedAt                   DateTime?                  @map("revoked_at") @db.Timestamptz(6)
  lastSeenAt                  DateTime                   @map("last_seen_at") @db.Timestamptz(6)
  createdAt                   DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  principal                   VnextPrincipal             @relation(fields: [principalId], references: [id], onDelete: Cascade)
  complianceSession           VnextComplianceSession?
  sourceMessages              VnextSourceMessage[]       @relation("VnextSourceMessageSession")
  safetyCases                 VnextSafetyCase[]          @relation("VnextSafetyCaseSession")
  continuousUseReceipts       VnextContinuousUseReminderReceipt[] @relation("VnextContinuousUseReceiptSession")

  @@unique([id, principalId])
  @@index([principalId, expiresAt])
  @@index([authState, expiresAt])
  @@map("vnext_experience_sessions")
}

model VnextComplianceSession {
  id                          String                       @id @default(uuid()) @db.Uuid
  ownerPrincipalId            String                       @map("owner_principal_id") @db.Uuid
  experienceSessionId         String                       @unique @map("experience_session_id") @db.Uuid
  audienceMode                VnextAudienceMode            @map("audience_mode")
  inputPolicy                 VnextInputPolicy             @map("input_policy")
  admissionPolicyVersion      String                       @map("admission_policy_version")
  aiIdentityNoticeVersion     String                       @map("ai_identity_notice_version")
  aiIdentityAcknowledgedAt    DateTime                     @map("ai_identity_acknowledged_at") @db.Timestamptz(6)
  serviceTermsVersion         String                       @map("service_terms_version")
  serviceTermsAcceptedAt      DateTime                     @map("service_terms_accepted_at") @db.Timestamptz(6)
  privacyNoticeVersion        String                       @map("privacy_notice_version")
  privacyNoticeAcknowledgedAt DateTime                     @map("privacy_notice_acknowledged_at") @db.Timestamptz(6)
  ageVerificationStatus       VnextAgeVerificationStatus   @default(PENDING) @map("age_verification_status")
  ageVerificationRef          String?                      @map("age_verification_ref")
  safetyContactRef            String?                      @map("safety_contact_ref")
  continuousUseStartedAt      DateTime                     @map("continuous_use_started_at") @db.Timestamptz(6)
  lastDurationReminderAt      DateTime?                    @map("last_duration_reminder_at") @db.Timestamptz(6)
  status                      VnextComplianceStatus        @default(PENDING)
  version                     Int                          @default(1)
  processingBasisRefs         Json                         @default("[]") @map("processing_basis_refs")
  consentRefs                 Json                         @default("[]") @map("consent_refs")
  safetyCaseRefs              Json                         @default("[]") @map("safety_case_refs")
  auditRefs                   Json                         @default("[]") @map("audit_refs")
  createdAt                   DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(6)
  experienceSession           VnextExperienceSession       @relation(fields: [experienceSessionId, ownerPrincipalId], references: [id, principalId], onDelete: Cascade)
  processingBases             VnextProcessingBasisRecord[] @relation("VnextProcessingBasisCompliance")
  consents                    VnextConsentRecord[]         @relation("VnextConsentCompliance")
  safetyCases                 VnextSafetyCase[]            @relation("VnextSafetyCaseCompliance")
  continuousUseReceipts       VnextContinuousUseReminderReceipt[] @relation("VnextContinuousUseReceiptCompliance")

  @@unique([id, ownerPrincipalId], map: "vnext_compliance_sessions_id_owner_key")
  @@unique([id, experienceSessionId, ownerPrincipalId], map: "vnext_compliance_sessions_scope_key")
  @@unique([experienceSessionId, ownerPrincipalId])
  @@index([ownerPrincipalId, status])
  @@map("vnext_compliance_sessions")
}

model VnextSourceMessage {
  id                     String                   @id @default(uuid()) @db.Uuid
  ownerPrincipalId       String                   @map("owner_principal_id") @db.Uuid
  experienceSessionId    String                   @map("experience_session_id") @db.Uuid
  clientRequestId        String                   @map("client_request_id") @db.VarChar(200)
  action                 VnextSourceMessageAction
  body                   String                   @db.Text
  requestDigest          String                   @map("request_digest") @db.Char(64)
  basedOnUnderstandingId String?                  @map("based_on_understanding_id") @db.Uuid
  basedOnVersion         Int?                     @map("based_on_version")
  createdAt              DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  owner                  VnextPrincipal           @relation("VnextSourceMessageOwner", fields: [ownerPrincipalId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  experienceSession      VnextExperienceSession   @relation("VnextSourceMessageSession", fields: [experienceSessionId, ownerPrincipalId], references: [id, principalId], onDelete: NoAction, onUpdate: Cascade)
  basedOnUnderstanding   VnextUnderstandingDraft? @relation("VnextSourceBasedOnUnderstanding", fields: [basedOnUnderstandingId, ownerPrincipalId, basedOnVersion], references: [id, ownerPrincipalId, version], onDelete: NoAction, onUpdate: Cascade)
  originWorkspace        VnextStoryWorkspace?     @relation("VnextWorkspaceOriginSource")
  understandingDraft     VnextUnderstandingDraft? @relation("VnextUnderstandingSource")
  readerMemoryItems      VnextReaderMemoryItem[]  @relation("VnextMemoryItemSource")
  creativeTasks          VnextCreativeTask[]      @relation("VnextCreativeTaskSource")

  @@unique([id, ownerPrincipalId], map: "vnext_source_messages_id_owner_key")
  @@unique([ownerPrincipalId, clientRequestId], map: "vnext_source_messages_owner_request_key")
  @@index([ownerPrincipalId, createdAt], map: "vnext_source_messages_owner_created_idx")
  @@map("vnext_source_messages")
}

model VnextStoryWorkspace {
  id                    String                    @id @default(uuid()) @db.Uuid
  ownerPrincipalId      String                    @map("owner_principal_id") @db.Uuid
  originSourceMessageId String                    @map("origin_source_message_id") @db.Uuid
  status                VnextStoryWorkspaceStatus @default(FORMING)
  aggregateVersion      Int                       @default(1) @map("aggregate_version")
  publicationDigest     String                    @map("publication_digest") @db.Char(64)
  createdAt             DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  owner                 VnextPrincipal            @relation("VnextStoryWorkspaceOwner", fields: [ownerPrincipalId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  originSourceMessage   VnextSourceMessage        @relation("VnextWorkspaceOriginSource", fields: [originSourceMessageId, ownerPrincipalId], references: [id, ownerPrincipalId], onDelete: NoAction, onUpdate: Cascade)
  understandingDrafts   VnextUnderstandingDraft[] @relation("VnextUnderstandingWorkspace")
  commissionBriefs      VnextCommissionBrief[]    @relation("VnextCommissionWorkspace")
  creativeTasks         VnextCreativeTask[]       @relation("VnextCreativeTaskWorkspace")
  storyContents         VnextStoryContent[]       @relation("VnextStoryContentWorkspace")
  safetyCases           VnextSafetyCase[]         @relation("VnextSafetyCaseWorkspace")
  systemSupportCases    VnextSystemSupportCase[]  @relation("VnextSystemSupportCaseWorkspace")

  @@unique([id, ownerPrincipalId], map: "vnext_story_workspaces_id_owner_key")
  @@unique([originSourceMessageId, ownerPrincipalId], map: "vnext_story_workspaces_owner_origin_key")
  @@index([ownerPrincipalId, status, updatedAt], map: "vnext_story_workspaces_owner_status_idx")
  @@map("vnext_story_workspaces")
}

model VnextUnderstandingDraft {
  id                        String                   @id @default(uuid()) @db.Uuid
  ownerPrincipalId          String                   @map("owner_principal_id") @db.Uuid
  workspaceId               String                   @map("workspace_id") @db.Uuid
  sourceMessageId           String                   @map("source_message_id") @db.Uuid
  supersedesUnderstandingId String?                  @map("supersedes_understanding_id") @db.Uuid
  storyDesire               String                   @map("story_desire") @db.Text
  emotionalTarget           String                   @map("emotional_target") @db.Text
  relationshipTension       String                   @map("relationship_tension") @db.Text
  hardBoundaries            Json                     @default("[]") @map("hard_boundaries")
  clarificationQuestions    Json                     @default("[]") @map("clarification_questions")
  confidence                Float                    @db.Real
  userCorrection            String?                  @map("user_correction") @db.Text
  status                    VnextUnderstandingStatus @default(PROPOSED)
  version                   Int                      @default(1)
  payloadDigest             String                   @map("payload_digest") @db.Char(64)
  publicationSnapshot       Json                     @map("publication_snapshot")
  createdAt                 DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  owner                     VnextPrincipal           @relation("VnextUnderstandingOwner", fields: [ownerPrincipalId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  workspace                 VnextStoryWorkspace      @relation("VnextUnderstandingWorkspace", fields: [workspaceId, ownerPrincipalId], references: [id, ownerPrincipalId], onDelete: Cascade, onUpdate: Cascade)
  sourceMessage             VnextSourceMessage       @relation("VnextUnderstandingSource", fields: [sourceMessageId, ownerPrincipalId], references: [id, ownerPrincipalId], onDelete: NoAction, onUpdate: Cascade)
  supersedesUnderstanding   VnextUnderstandingDraft? @relation("VnextUnderstandingVersions", fields: [supersedesUnderstandingId, ownerPrincipalId, workspaceId], references: [id, ownerPrincipalId, workspaceId], onDelete: NoAction, onUpdate: Cascade)
  supersededByUnderstanding VnextUnderstandingDraft? @relation("VnextUnderstandingVersions")
  correctionSourceMessages  VnextSourceMessage[]     @relation("VnextSourceBasedOnUnderstanding")
  commissionBrief           VnextCommissionBrief?    @relation("VnextCommissionUnderstanding")
  creativeTasks             VnextCreativeTask[]      @relation("VnextCreativeTaskUnderstanding")

  @@unique([id, ownerPrincipalId], map: "vnext_understandings_id_owner_key")
  @@unique([id, ownerPrincipalId, version], map: "vnext_understandings_id_owner_version_key")
  @@unique([id, ownerPrincipalId, workspaceId], map: "vnext_understandings_id_owner_workspace_key")
  @@unique([sourceMessageId, ownerPrincipalId], map: "vnext_understandings_owner_source_key")
  @@unique([supersedesUnderstandingId, ownerPrincipalId, workspaceId], map: "vnext_understandings_supersedes_key")
  @@unique([workspaceId, ownerPrincipalId, version], map: "vnext_understandings_workspace_version_key")
  @@index([ownerPrincipalId, workspaceId, status], map: "vnext_understandings_owner_workspace_idx")
  @@map("vnext_understanding_drafts")
}

model VnextCommissionBrief {
  id                     String                  @id @default(uuid()) @db.Uuid
  ownerPrincipalId       String                  @map("owner_principal_id") @db.Uuid
  workspaceId            String                  @map("workspace_id") @db.Uuid
  sourceUnderstandingId  String                  @map("source_understanding_id") @db.Uuid
  supersedesCommissionId String?                 @map("supersedes_commission_id") @db.Uuid
  premise                String                  @db.Text
  emotionalPromise       String                  @map("emotional_promise") @db.Text
  relationshipCore       String                  @map("relationship_core") @db.Text
  styleConstraints       Json                    @default("[]") @map("style_constraints")
  hardBoundaries         Json                    @default("[]") @map("hard_boundaries")
  continuationIntent     String                  @map("continuation_intent") @db.Text
  version                Int                     @default(1)
  status                 VnextCommissionStatus   @default(DRAFT)
  payloadDigest          String                  @map("payload_digest") @db.Char(64)
  createdAt              DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  owner                  VnextPrincipal          @relation("VnextCommissionOwner", fields: [ownerPrincipalId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  workspace              VnextStoryWorkspace     @relation("VnextCommissionWorkspace", fields: [workspaceId, ownerPrincipalId], references: [id, ownerPrincipalId], onDelete: Cascade, onUpdate: Cascade)
  sourceUnderstanding    VnextUnderstandingDraft @relation("VnextCommissionUnderstanding", fields: [sourceUnderstandingId, ownerPrincipalId, workspaceId], references: [id, ownerPrincipalId, workspaceId], onDelete: Cascade, onUpdate: Cascade)
  supersedesCommission   VnextCommissionBrief?   @relation("VnextCommissionVersions", fields: [supersedesCommissionId, ownerPrincipalId, workspaceId], references: [id, ownerPrincipalId, workspaceId], onDelete: NoAction, onUpdate: Cascade)
  supersededByCommission VnextCommissionBrief?   @relation("VnextCommissionVersions")
  creativeTasks          VnextCreativeTask[]     @relation("VnextCreativeTaskCommission")

  @@unique([id, ownerPrincipalId], map: "vnext_commissions_id_owner_key")
  @@unique([id, ownerPrincipalId, workspaceId], map: "vnext_commissions_id_owner_workspace_key")
  @@unique([sourceUnderstandingId, ownerPrincipalId, workspaceId], map: "vnext_commissions_owner_understanding_key")
  @@unique([supersedesCommissionId, ownerPrincipalId, workspaceId], map: "vnext_commissions_supersedes_key")
  @@unique([workspaceId, ownerPrincipalId, version], map: "vnext_commissions_workspace_version_key")
  @@index([ownerPrincipalId, workspaceId, status], map: "vnext_commissions_owner_workspace_idx")
