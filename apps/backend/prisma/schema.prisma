  channelMessageId String   @map("channel_message_id")
  channel          String
  text             String
  createdAt        DateTime @map("created_at") @db.Timestamptz(6)

  @@index([accountId, createdAt])
  @@map("normalized_messages")
}

model ChatRouteDecision {
