  commandType            VnextSystemSupportCommandType   @map("command_type")
  actor                  VnextSystemSupportCommandActor
  requestDigest          String                          @map("request_digest") @db.Char(64)
  basedOnVersionId       String?                         @map("based_on_version_id") @db.Uuid
  resultVersionId        String                          @map("result_version_id") @db.Uuid
  resultAggregateVersion Int                             @map("result_aggregate_version")
  firstFactSequence      Int                             @map("first_fact_sequence")
  lastFactSequence       Int                             @map("last_fact_sequence")
  createdAt              DateTime                        @default(now()) @map("created_at") @db.Timestamptz(6)
  supportCase            VnextSystemSupportCase          @relation("VnextSystemSupportCaseCommands", fields: [caseId, ownerPrincipalId], references: [id, ownerPrincipalId], onDelete: Cascade, onUpdate: Cascade)
  facts                  VnextSystemSupportFact[]         @relation("VnextSystemSupportCommandFacts")

  @@unique([id, caseId, ownerPrincipalId], map: "vnext_system_support_commands_scope_key")
  @@unique([ownerPrincipalId, clientRequestId], map: "vnext_system_support_commands_owner_request_key")
  @@unique([caseId, resultAggregateVersion], map: "vnext_system_support_commands_case_version_key")
  @@unique([caseId, resultVersionId], map: "vnext_system_support_commands_case_version_id_key")
  @@index([caseId, createdAt], map: "vnext_system_support_commands_case_created_idx")
  @@map("vnext_system_support_commands")
}

model VnextSystemSupportFact {
  id               String                        @id @default(uuid()) @db.Uuid
  caseId           String                        @map("case_id") @db.Uuid
  ownerPrincipalId String                        @map("owner_principal_id") @db.Uuid
  commandId        String                        @map("command_id") @db.Uuid
  sequence         Int
  factType         VnextSystemSupportFactType    @map("fact_type")
  payload          Json
  payloadDigest    String                        @map("payload_digest") @db.Char(64)
  createdAt        DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)
  supportCase      VnextSystemSupportCase        @relation("VnextSystemSupportCaseFacts", fields: [caseId, ownerPrincipalId], references: [id, ownerPrincipalId], onDelete: Cascade, onUpdate: Cascade)
  command          VnextSystemSupportCommand     @relation("VnextSystemSupportCommandFacts", fields: [commandId, caseId, ownerPrincipalId], references: [id, caseId, ownerPrincipalId], onDelete: Cascade, onUpdate: Cascade)

  @@unique([caseId, sequence], map: "vnext_system_support_facts_case_sequence_key")
  @@unique([id, caseId, ownerPrincipalId], map: "vnext_system_support_facts_scope_key")
  @@index([caseId, factType, sequence], map: "vnext_system_support_facts_case_type_idx")
  @@map("vnext_system_support_facts")
}

model VnextOutboxEvent {
  id               String                 @id @default(uuid()) @db.Uuid
  ownerPrincipalId String                 @map("owner_principal_id") @db.Uuid
  taskId           String?                @map("task_id") @db.Uuid
  aggregateType    String                 @map("aggregate_type") @db.VarChar(100)
  aggregateId      String                 @map("aggregate_id") @db.Uuid
  aggregateVersion Int                    @map("aggregate_version")
  eventType        String                 @map("event_type") @db.VarChar(150)
  idempotencyKey   String                 @map("idempotency_key") @db.VarChar(200)
  payload          Json
  payloadDigest    String                 @map("payload_digest") @db.Char(64)
  status           VnextOutboxEventStatus @default(PENDING)
  attemptCount     Int                    @default(0) @map("attempt_count") @db.SmallInt
  maxAttempts      Int                    @default(10) @map("max_attempts") @db.SmallInt
  availableAt      DateTime               @map("available_at") @db.Timestamptz(6)
  leaseOwner       String?                @map("lease_owner") @db.VarChar(200)
  leaseToken       String?                @map("lease_token") @db.Uuid
  leaseExpiresAt   DateTime?              @map("lease_expires_at") @db.Timestamptz(6)
  publishedAt      DateTime?              @map("published_at") @db.Timestamptz(6)
  lastFailureCode  String?                @map("last_failure_code") @db.VarChar(100)
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  owner            VnextPrincipal         @relation("VnextOutboxEventOwner", fields: [ownerPrincipalId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  task             VnextCreativeTask?     @relation("VnextOutboxTask", fields: [taskId, ownerPrincipalId], references: [id, ownerPrincipalId], onDelete: NoAction, onUpdate: Cascade)

  @@unique([ownerPrincipalId, idempotencyKey], map: "vnext_outbox_owner_idempotency_key")
  @@index([aggregateType, aggregateId, aggregateVersion], map: "vnext_outbox_aggregate_idx")
  @@index([status, availableAt, createdAt], map: "vnext_outbox_dispatch_idx")
  @@index([status, leaseExpiresAt], map: "vnext_outbox_lease_idx")
  @@map("vnext_outbox_events")
}

model VnextWorkerHeartbeat {
  workerId        String                   @id @map("worker_id") @db.VarChar(200)
  kind            VnextWorkerKind          @default(CREATIVE)
  status          VnextWorkerStatus        @default(STARTING)
  runtimeMode     VnextCreativeRuntimeMode @map("runtime_mode")
  buildId         String                   @map("build_id") @db.VarChar(200)
  processId       Int                      @map("process_id")
  supportedKinds  Json                     @map("supported_kinds")
  metadata        Json                     @default("{}")
  startedAt       DateTime                 @map("started_at") @db.Timestamptz(6)
  lastHeartbeatAt DateTime                 @map("last_heartbeat_at") @db.Timestamptz(6)
  lastClaimedAt   DateTime?                @map("last_claimed_at") @db.Timestamptz(6)
  lastSucceededAt DateTime?                @map("last_succeeded_at") @db.Timestamptz(6)
  lastFailedAt    DateTime?                @map("last_failed_at") @db.Timestamptz(6)
  stoppedAt       DateTime?                @map("stopped_at") @db.Timestamptz(6)
  lastErrorCode   String?                  @map("last_error_code") @db.VarChar(100)
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([kind, status, lastHeartbeatAt], map: "vnext_worker_heartbeat_readiness_idx")
  @@map("vnext_worker_heartbeats")
}

model AppStateSnapshot {
  stateKey      String   @id @map("state_key")
  schemaVersion Int      @default(1) @map("schema_version")
  stateVersion  Int      @default(1) @map("state_version")
  payload       Json
  updatedAt     DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("app_state_snapshots")
}

model Account {
  id                    String               @id @db.Uuid
  accountToken          String               @unique @map("account_token")
  accountStatus         String               @map("account_status")
  primaryChannel        String               @map("primary_channel")
  acceptedPolicyVersion String?              @map("accepted_policy_version")
  createdAt             DateTime             @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime             @map("updated_at") @db.Timestamptz(6)
  storyIntakeSessions   StoryIntakeSession[]
  storyWorkspaces       StoryWorkspace[]
  sessions              AccountSession[]

  @@map("accounts")
}

model AccountSession {
  sessionId  String    @id @map("session_id") @db.Uuid
  accountId  String    @map("account_id") @db.Uuid
  deviceId   String?   @map("device_id")
  deviceType String?   @map("device_type")
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  lastSeenAt DateTime  @map("last_seen_at") @db.Timestamptz(6)
  account    Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([accountId, deviceId])
  @@map("account_sessions")
}

model StoryIntakeSession {
  id                 String          @id @db.Uuid
  accountId          String          @map("account_id") @db.Uuid
  entrySurface       String          @map("entry_surface")
  intakeMode         String          @map("intake_mode")
  briefPayload       Json            @map("brief_payload")
  status             String
  selectedProposalId String?         @map("selected_proposal_id") @db.Uuid
  clientRequestId    String          @map("client_request_id")
  createdAt          DateTime        @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime        @map("updated_at") @db.Timestamptz(6)
  account            Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  proposals          StoryProposal[]

  @@map("story_intake_sessions")
}

model StoryProposal {
  id         String             @id @db.Uuid
  sessionId  String             @map("session_id") @db.Uuid
  proposalNo Int                @map("proposal_no")
  title      String
  summary    String
  payload    Json
  status     String
  createdAt  DateTime           @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime           @map("updated_at") @db.Timestamptz(6)
  session    StoryIntakeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, proposalNo])
  @@map("story_proposals")
}

model StoryWorkspace {
  id               String   @id @db.Uuid
  accountId        String   @map("account_id") @db.Uuid
  title            String
  keywords         Json
  workspaceStatus  String   @map("workspace_status")
  entrySurface     String?  @map("entry_surface")
  intakeMode       String?  @map("intake_mode")
  privacyScope     String?  @map("privacy_scope")
  commissionBrief  Json?    @map("commission_brief")
  currentChapterId String?  @map("current_chapter_id") @db.Uuid
  createdAt        DateTime @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @map("updated_at") @db.Timestamptz(6)
  updatedBy        String   @map("updated_by")
  account          Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, title])
  @@map("story_workspaces")
}

model NormalizedMessage {
  id               String   @id @db.Uuid
